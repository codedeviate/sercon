# DevShop (sws6) test secrets — copy to `.env` (gitignored) and fill in.
#
# Load before running the sws6 scripts, e.g.:
#   set -a; source examples/scripts/sws6/.env; set +a
#   ./sercon examples/scripts/sws6/login.ts
#
# sercon reads these via runtime.env.get — it does NOT auto-load .env, so you
# must export them into the environment yourself (the `set -a; source` above
# does that). Scripts that need a value self-skip with a message when it's unset.

# --- host (non-secret; override only if your dev host differs) ---
DEVSHOP_BASE=http://dev-shop.sws.local

# --- existing test-customer login ---
DEVSHOP_EMAIL=
DEVSHOP_PASSWORD=

# --- buyer persona contact fields (kept out of git) ---
DEVSHOP_PERSONA_EMAIL=
DEVSHOP_PERSONA_PHONE=

# --- payment test data (public provider test values) ---
# Default card (KCO / Qliro use this):
DEVSHOP_CARD=
DEVSHOP_CARD_EXP=
DEVSHOP_CARD_CCV=
# Svea Checkout (SCO):
DEVSHOP_SCO_CARD=
DEVSHOP_SCO_PERSONNR=
DEVSHOP_SCO_ORGNR=
DEVSHOP_SCO_POSTAL=
# Nets:
DEVSHOP_NETS_CARD=
DEVSHOP_NETS_PERSONNR=
DEVSHOP_NETS_POSTAL=
# Qliro:
DEVSHOP_QLIRO_PERSONNR=
DEVSHOP_QLIRO_ORGNR=
